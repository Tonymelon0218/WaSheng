 661          void MipiVideoSet(void)
 662          {
 663   1              chip_write_i2c(0xC21C, 0x00);
 664   1              switch (g_MipiSetStr.SetPortLaneNum)
 665   1              {
 666   2              case 4:
 667   2                      chip_write_i2c(0xC201, 0x00 | g_MipiSetStr.SetVideoMode | g_MipiType);
 668   2                      chip_write_i2c(0xC256, 0x00 | g_MipiSetStr.SetVideoMode | g_MipiType);
 669   2                      chip_write_i2c(0xC202, 0x01);
 670   2                      chip_write_i2c(0xC203, 0x55);
 671   2                      break;
 672   2              case 3:
C51 COMPILER V9.60.0.0   MIPI                                                              11/25/2025 16:45:53 PAGE 12  

 673   2                      chip_write_i2c(0xC201, 0x30 | g_MipiSetStr.SetVideoMode | g_MipiType);
 674   2                      chip_write_i2c(0xC256, 0x30 | g_MipiSetStr.SetVideoMode | g_MipiType);
 675   2                      chip_write_i2c(0xC202, 0x01);
 676   2                      chip_write_i2c(0xC203, 0x90);
 677   2                      break;
 678   2              case 2:
 679   2                      chip_write_i2c(0xC201, 0x20 | g_MipiSetStr.SetVideoMode | g_MipiType);
 680   2                      chip_write_i2c(0xC256, 0x20 | g_MipiSetStr.SetVideoMode | g_MipiType);
 681   2                      chip_write_i2c(0xC202, 0x02);
 682   2                      chip_write_i2c(0xC203, 0x58);
 683   2                      break;
 684   2              case 1:
 685   2                      chip_write_i2c(0xC201, 0x10 | g_MipiSetStr.SetVideoMode | g_MipiType);
 686   2                      chip_write_i2c(0xC256, 0x10 | g_MipiSetStr.SetVideoMode | g_MipiType);
 687   2                      chip_write_i2c(0xC202, 0x03);
 688   2                      chip_write_i2c(0xC203, 0x00);
 689   2                      break;
 690   2              }
 691   1              DelayMs(20);
 692   1              chip_write_i2c(0xC200, g_MipiSetStr.SetClockMode);
 693   1              if (g_MipiType == DSI) // only DSI needs EOTP
 694   1              {
 695   2                      chip_write_i2c(0xC214, chip_read_i2c(0xC214) | 0x80);
 696   2                      chip_write_i2c(0xC200, chip_read_i2c(0xC200) | 0x80);
 697   2              }
 698   1              else
 699   1              {
 700   2                      chip_write_i2c(0xC202, g_RdDly / 256);
 701   2                      chip_write_i2c(0xC203, g_RdDly % 256);
 702   2              }
 703   1      }
