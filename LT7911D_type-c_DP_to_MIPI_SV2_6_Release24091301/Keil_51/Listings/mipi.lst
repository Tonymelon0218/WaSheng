 623          void MipiRdDlyCal(void)
 624          {
 625   1              u32 rd_dly = 0;
 626   1              u16 rd_Hsw, rd_Hbp, rd_Hactive;
 627   1              u32 m, x, y = 0;
 628   1              u16 rdpixclk = 0;
 629   1              u16 rdbyteclk = 0;
 630   1      
 631   1              chip_write_i2c(0xA034, 0x1A);
 632   1              DelayMs(10);
 633   1              g_MipiByteClock = chip_read_i2c(0xB8B1);
 634   1              g_MipiByteClock = (g_MipiByteClock << 8) + chip_read_i2c(0xB8B2);
 635   1              g_MipiByteClock = (g_MipiByteClock << 8) + chip_read_i2c(0xB8B3);
 636   1              chip_write_i2c(0xA034, 0x01);
 637   1      
 638   1              rdpixclk = g_TimingStr.PixelClock / 1000 / g_DisplayMode;
 639   1              rdbyteclk = g_MipiByteClock / 1000;
 640   1              // printf("\n[PixClock]  : %d MHz\n", rdpixclk);
 641   1              rd_Hsw = g_TimingStr.Hsw / g_DisplayMode;
 642   1              rd_Hbp = g_TimingStr.Hbp / g_DisplayMode;
 643   1              rd_Hactive = g_TimingStr.Hactive / g_DisplayMode;
 644   1              // printf(" \n[H]  : Hsw:%d  Hbp:%d  Hactive :%d  \n",   rdhsw, rdhbp, rdhactive);
 645   1      
 646   1              m = rd_Hsw + rd_Hbp + rd_Hactive;
 647   1              x = m * (rdbyteclk + 1);
 648   1              y = x / (rdpixclk - 1);
 649   1      
 650   1              if (g_MipiFormat == YUV422_8bit)
 651   1              {
 652   2                      rd_dly = y - (2 * rd_Hactive) / g_MipiSetStr.SetPortLaneNum;
 653   2              }
 654   1              else if (g_MipiFormat == RGB888)
 655   1              {
 656   2                      rd_dly = y - (3 * rd_Hactive) / g_MipiSetStr.SetPortLaneNum;
 657   2              }
 658   1              g_RdDly = rd_dly;
 659   1      }
