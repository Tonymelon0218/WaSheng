 366   2              }
 367   1              else if ((wr_byteclk < 80) && (wr_byteclk >= 40))
 368   1              {
 369   2                      chip_write_i2c(0xB03E, 0x00);
 370   2                      wr_freq_div = 2;
 371   2              }
 372   1              else if ((wr_byteclk < 40) && (wr_byteclk >= 20))
 373   1              {
 374   2                      chip_write_i2c(0xB03E, 0x20);
 375   2                      wr_freq_div = 4;
 376   2              }
 377   1              else if ((wr_byteclk < 20) && (wr_byteclk >= 10))
 378   1              {
