 339   1      
 340   1              switch (g_MipiFormat)
 341   1              {
 342   2              case RGB888:
 343   2                      wr_byteclk = (rd_pixelclk * 3) / g_MipiSetStr.SetPortLaneNum / g_DisplayMode;
 344   2                      break;
 345   2              case YUV422_8bit:
 346   2                      wr_byteclk = (rd_pixelclk * 2) / g_MipiSetStr.SetPortLaneNum / g_DisplayMode;
 347   2                      break;
 348   2              default:
 349   2                      break;
 350   2              }
 351   1      
 352   1              wr_byteclk += OFFSET;
 353   1      
 354   1              if (wr_byteclk < 50)
