  89          void DcsPktWrite(u8 DCS_DI, u8 Len, u8 *Ptr)
  90          {
  91   1              u8 i = 0;
  92   1              chip_write_i2c(0xC21C, 0x40); // Write enable;
  93   1              if (Len == 2)
  94   1              {
  95   2                      chip_write_i2c(0xC218, 0x0C); // Hardware calculate ecc and crc&LP mode send pkt enable&Short pkt
  96   2                      chip_write_i2c(0xC219, 0x04);
  97   2                      chip_write_i2c(0xC234, DCS_DI);
  98   2                      chip_write_i2c(0xC234, *Ptr);
  99   2                      chip_write_i2c(0xC234, *(Ptr + 1));
 100   2              }
 101   1              else
 102   1              {
 103   2                      chip_write_i2c(0xC218, 0x0E);
 104   2                      chip_write_i2c(0xC219, Len + 6);
 105   2                      chip_write_i2c(0xC234, DCS_DI);
 106   2                      chip_write_i2c(0xC234, Len);
 107   2                      chip_write_i2c(0xC234, 0x00);
 108   2                      for (i = 0; i < Len; i++)
 109   2                      {
 110   3                              chip_write_i2c(0xC234, *Ptr);
 111   3                              Ptr++;
 112   3                      }
 113   2              }
 114   1              DelayMs(1);
 115   1              chip_write_i2c(0xC218, 0x00);
