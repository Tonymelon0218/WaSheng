 165          void DPCD_Parameter(u32 Addr, u8 Data)
 166          {
 167   1              // D855: bit[7]: 0:aux mode; 1:reg mode
 168   1              // D852: DPCD[19:16]
 169   1              // D851: DPCD[15:8]
 170   1              // D850: DPCD[7:0]
 171   1              // D853: Data
 172   1              BKD8_55_REG = 0x80; // Aux reg mode
 173   1              BKD8_52_REG = ((Addr >> 16) & 0x0f);
 174   1              BKD8_51_REG = ((Addr >> 8) & 0xff);
 175   1              BKD8_50_REG = (Addr & 0xff);
 176   1              BKD8_53_REG = Data;
 177   1      }
