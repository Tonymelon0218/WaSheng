  22          void EDID_Dtb_Block_Calc(u8 *Pbuf)
  23          {
  24   1              u16 Hblanking, Vblanking;
  25   1      
  26   1              Hblanking = g_TimingStr.Hfp + g_TimingStr.Hsw + g_TimingStr.Hbp;
  27   1              Vblanking = g_TimingStr.Vfp + g_TimingStr.Vsw + g_TimingStr.Vbp;
  28   1      
  29   1              Pbuf[0] = (g_TimingStr.PixelClock / 10) % 256;                                  // pix_clock low
  30   1              Pbuf[1] = (g_TimingStr.PixelClock / 10) / 256;                                  // pix_clock high
  31   1              Pbuf[2] = g_TimingStr.Hactive % 256;                                                    // hact low
  32   1              Pbuf[3] = Hblanking % 256;                                                                              // H blanking low
  33   1              Pbuf[4] = ((g_TimingStr.Hactive / 256) << 4) + Hblanking / 256; // Hact : Hblank
  34   1              Pbuf[5] = g_TimingStr.Vactive % 256;                                                    // vact low
  35   1              Pbuf[6] = Vblanking % 256;                                                                              // V blanking low
  36   1              Pbuf[7] = ((g_TimingStr.Vactive / 256) << 4) + Vblanking / 256; // Hact : Hblank
  37   1              Pbuf[8] = g_TimingStr.Hfp % 256;                                                                // H sync offset low
  38   1              Pbuf[9] = g_TimingStr.Hsw % 256;                                                                // H sync width low
  39   1              Pbuf[10] = ((g_TimingStr.Vfp % 16) << 4) + g_TimingStr.Vsw % 16;
  40   1              Pbuf[11] = ((g_TimingStr.Hfp / 256) << 6) + ((g_TimingStr.Hsw / 256) << 4) +
  41   1                                 ((g_TimingStr.Vfp / 16) << 2) + (g_TimingStr.Vsw / 16);
  42   1              Pbuf[12] = g_TimingStr.Hactive % 256;
  43   1              Pbuf[13] = g_TimingStr.Vactive % 256;
  44   1              Pbuf[14] = ((g_TimingStr.Hactive / 256) << 4) + g_TimingStr.Vactive / 256;
  45   1              Pbuf[17] = (0x18 | (g_TimingStr.Hspol << 1)) | (g_TimingStr.Vspol << 2); // progress V+ H+
  46   1      }
